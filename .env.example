FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-in-production

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=smart_learning_portfolio
DB_USER=smart_learning_app
DB_PASSWORD=change-this-password

ADMIN_DEFAULT_PASSWORD=admin123

UPLOAD_FOLDER=instance/uploads
MAX_CONTENT_LENGTH_MB=10

# AI（Google Gemini）：到 https://aistudio.google.com/ 申請金鑰，填在自己的 .env，不要 commit
AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ASSISTANT_MODEL=gemini-flash-lite-latest
# 招生資料 Agent 只擷取科系名稱含這些字的校系
AGENT_PROGRAM_KEYWORDS=資訊管理,資管,資訊應用,資訊工程
